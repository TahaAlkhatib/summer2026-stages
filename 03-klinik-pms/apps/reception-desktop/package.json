{
  "name": "klinik-resepsiyon",
  "version": "1.0.0",
  "description": "Klinik PMS - Resepsiyon masaüstü uygulaması",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm:vite\" \"npm:electron:dev\"",
    "vite": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "electron:dev": "wait-on tcp:5113 && cross-env-shell KLINIK_DEV=1 electron ."
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
